// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Bcrypt hash - null for any user created via a future OAuth provider,
  // which is why it's optional rather than required.
  password      String?

  // ── Billing / dual-gateway subscription state ──────────────────────────────
  // `plan` is the entitlement the whole app gates on ("FREE" | "PRO"); it stays
  // a plain String (not an enum) to match the existing default and the session
  // typing in src/types/next-auth.d.ts. `planStatus` mirrors the gateway's
  // subscription status ("ACTIVE" | "CANCELED"), null while a user is on FREE.
  plan                   String    @default("FREE")
  planStatus             String?
  currentPeriodEnd       DateTime?
  // Gateway ids are nullable + unique: a given user pays through exactly one
  // gateway (Razorpay for IN, Stripe for INTL), and an id maps to one user.
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  razorpayCustomerId     String?   @unique
  razorpaySubscriptionId String?   @unique

  // Gamification: consecutive-day study streak and the last day it advanced.
  // lastStudyDate is nullable so existing users start with no recorded study.
  currentStreak         Int       @default(0)
  lastStudyDate         DateTime?
  // Monetization: FREE plans are capped at 1 generation per calendar day.
  // decksGeneratedToday is the running count for the current day; it's reset
  // in application code when lastDeckGeneratedDate rolls over to a new day
  // (nullable so existing users start with no recorded generation).
  decksGeneratedToday   Int       @default(0)
  lastDeckGeneratedDate DateTime?
  // Monetization: the shared AI-lookup allowance spent by /api/define (a word
  // looked up in the reader), /api/ask and /api/concept-map. Now FREE_LOOKUPS_PER_MONTH
  // per CALENDAR MONTH, rolled over in application code when lookupsResetAt predates
  // the student's current local month - it was 20 for life, which priced the whole
  // comprehension layer out of the free tier (mapping one deck alone costs
  // ceil(concepts/40) of it). PRO is unlimited and never checks the cap, but still
  // increments, so this doubles as a usage metric there.
  // lookupsResetAt is nullable: every existing row is mid-month by definition and
  // gets its first fresh allowance at the next boundary.
  definitionsUsed       Int       @default(0)
  lookupsResetAt        DateTime?
  // Monetization: the per-REQUEST generation allowance spent by /api/ingest (every
  // chunk, not just the first) and /api/decks/[id]/shuffle. Separate from
  // decksGeneratedToday because that one counts decks and the money is spent per
  // request - a single deck can be 20 requests, and "Generate Next Section" sends
  // four more per tap with isFirstChunk: false, which the deck gate never sees.
  // Both plans are bounded (see generationLimitForPlan); PRO's is fair-use.
  // generationResetAt is nullable for the same reason lookupsResetAt is: every
  // existing row is mid-month by definition and gets a fresh allowance at the next
  // boundary.
  generationRequestsUsed Int      @default(0)
  generationResetAt      DateTime?
  // Abuse ceiling for /api/cloze-grade, NOT a plan-gated feature limit like
  // decksGeneratedToday - this fires automatically during normal study
  // whenever a typed answer isn't an exact match, so it applies to FREE and
  // PRO alike (same free Groq model either way) and must stay generous
  // enough that heavy legitimate studying never comes close. Resets daily,
  // same rollover pattern as currentStreak/lastStudyDate above.
  clozeGradesToday      Int       @default(0)
  lastClozeGradeDate    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  // One row per calendar day the user studied - powers the weekly streak
  // calendar. currentStreak above stays the fast path for the navbar badge;
  // this is the detailed history the Streak modal renders.
  studyDays StudyDay[]

  // The learning record, synced from the device (see src/lib/recallSync.ts and
  // /api/sync). Cascade like studyDays: account deletion must take all of it.
  decks      Deck[]
  units      KnowledgeUnit[]
  reviews    ReviewRecord[]
  asks       AskRecord[]
  teachBacks TeachBackRecord[]
}

// ── The synced learning record ───────────────────────────────────────────────
//
// Row-for-row mirrors of the client types (src/lib/types.ts, src/lib/recallModel.ts)
// so the sync route has no translation layer to get wrong. Ids are supplied by the
// device, never generated here: the client is where a deck or a review comes into
// existence, and an id minted server-side would duplicate on the next push.
//
// Timestamps are DateTime here and epoch-ms numbers on the device; /api/sync
// converts at the boundary and nowhere else.
//
// There is deliberately NO memory table. MemoryRecord is a cache over the review
// log (its own docblock says so), so it is recomputed by rebuildMemory rather than
// synced - which removes the only state two devices could disagree about.

model Deck {
  id            String    @id
  userId        String
  title         String
  /**
   * Concept[] verbatim. A blob rather than a Concept table because the client
   * reads and writes a deck whole; the symmetry is what keeps the merge simple.
   */
  concepts      Json
  /**
   * Unprocessed source text for "Generate Next Section".
   */
  pendingChunks Json?
  model         String?
  createdAt     DateTime
  updatedAt     DateTime
  /**
   * Tombstone. A deleted deck is kept, not removed: a row that vanishes cannot
   * propagate, so the next pull from another device would hand it straight back.
   */
  deletedAt     DateTime?
  /**
   * ConceptEdge[] - how this deck's ideas relate (prerequisite / explains /
   * contrast). Added with the table rather than in a later migration purely
   * because this one had not been applied yet; nothing writes it until the
   * concept map ships, and null means "never mapped", not "no relationships".
   */
  conceptMap    Json?
  /**
   * Local midnight of the day this deck is examined, if the student set one. Feeds
   * daysUntilExam in desiredRetentionFor, which raises the retention floor to 0.95
   * inside 21 days. NULL means no exam, which is not the same as one in the past.
   */
  examDate      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // id alone is already the primary key. This compound exists so /api/sync can
  // upsert by (id, userId): a payload naming a deck id owned by someone else then
  // fails the create on the primary key instead of silently overwriting their row.
  @@unique([id, userId])
  @@index([userId, updatedAt])
}

model KnowledgeUnit {
  id           String   @id
  userId       String
  /**
   * `sourceDeckId` on the device - same name, so the mirror stays literal.
   */
  sourceDeckId String
  label        String
  importance   Float
  concept      Json
  createdAt    DateTime
  updatedAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, updatedAt])
}

/**
 * One retrieval, as it happened. Append-only on the device and append-only here:
 * never updated, never deleted. This is the asset the whole memory model can be
 * rebuilt from, which is what makes the merge a union with no conflict to settle.
 */
model ReviewRecord {
  id                String   @id
  userId            String
  unitId            String
  path              String
  reviewedAt        DateTime
  grade             Int
  correct           Boolean
  latencyMs         Int
  credited          Boolean
  elapsedDays       Float
  stabilityBefore   Float?
  stabilityAfter    Float
  /**
   * Absent means NOT ASKED, never "guessed" - see Confidence in recallModel.ts.
   */
  confidence        String?
  couplingOnSuccess Float
  couplingOnLapse   Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
}

model AskRecord {
  id             String   @id
  userId         String
  unitId         String
  question       String
  answer         String
  beyondMaterial Boolean
  askedAt        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, askedAt])
}

/**
 * One attempt at explaining a concept in the student's own words, and the three
 * lists that came back. Append-only on the device and append-only here: a second
 * attempt is a new row, never an edit of the first, because comparing this week's
 * explanation with last week's is the whole point of keeping them.
 * `attempt` is the student's own writing, which makes this the most personal table
 * in the schema - hence the same cascade as the rest.
 */
model TeachBackRecord {
  id          String   @id
  userId      String
  unitId      String
  attempt     String
  correct     String[]
  missing     String[]
  wrong       String[]
  attemptedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, attemptedAt])
}

// A single day on which a user studied. Upserted (one row per user per day) by
// the study-tracking route, so the weekly calendar is a cheap indexed range
// query. `day` is normalized to local midnight so a same-day repeat hits the
// same row rather than creating duplicates.
model StudyDay {
  id     String   @id @default(cuid())
  userId String
  day    DateTime
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
}

// The next four models match the exact shape @auth/prisma-adapter expects -
// see node_modules/@auth/prisma-adapter/src/index.ts for the queries it runs
// against them. Don't rename fields without checking that file first.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Tracks consumed mobile OAuth bridge tokens (see src/lib/mobileAuth.ts) so a
// captured token can only ever be redeemed once. The bridge token's
// flowrecall://auth-callback deep link isn't a verified Android App Link, so
// Android shows a disambiguation chooser if another app ever registers the
// same scheme+host - without this table, an app picked by mistake (or a
// malicious one racing the chooser) could replay the same captured token
// against /api/auth/mobile-exchange as many times as it wants within the
// token's 60-second validity window. jti is minted alongside the token in
// /api/mobile-callback; expiresAt mirrors the token's own maxAge so rows can
// be swept without ever touching a still-valid token.
model UsedMobileBridgeToken {
  jti       String   @id
  expiresAt DateTime
}
