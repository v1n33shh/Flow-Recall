<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppTheme (applied to <application> in AndroidManifest.xml) reads these
         three names directly. Without an app-level definition they silently
         fall back to @capacitor/android's bundled colors.xml - the stock
         Capacitor template's generic indigo/pink Material palette, not this
         app's actual "Pure Monochrome" brand (see the token comment block in
         src/app/globals.css, which these mirror). colorAccent used to be
         #3B82F6 (an "Electric Azure" leftover from before the monochrome
         rewrite) - it tints native chrome AppCompat still controls (ripples,
         text-selection handles), so a stray blue there undercut the
         zero-hue brand even though it never touched the logo itself. Matters
         most on minSdk 24-33 devices, where AppCompat still tints the status
         bar from colorPrimaryDark - Android 15+ (targetSdk 36 here) enforces
         edge-to-edge and ignores it, but this app's floor is 24. -->
    <color name="colorPrimary">#050505</color>
    <color name="colorPrimaryDark">#000000</color>
    <color name="colorAccent">#FAFAFA</color>

    <!-- The Android 12+ SplashScreen API's windowSplashScreenBackground - must
         match globals.css's background token (#050505) exactly, and the React
         AppLoader's own background, or the native-to-web handoff shows a
         one-frame color seam. -->
    <color name="splashBackground">#050505</color>
</resources>
