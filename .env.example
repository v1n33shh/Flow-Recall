# Copy to .env and fill in real values. .env is gitignored - never commit secrets.

# Postgres connection string - e.g. from Supabase: Project Settings > Database > Connection string (URI, "Transaction" pooler mode).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- NextAuth (Auth.js v5) - Credentials (email/password), no external OAuth ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# --- AI providers (server-side only - never sent from the client) ---
# FREE plans are pinned to Groq's llama-3.1-8b-instant.
GROQ_API_KEY=""
# The Groq model FREE plans are pinned to. Optional - src/lib/ai.ts defaults to the
# current id. Set BOTH to the same value when Groq deprecates it (they have twice):
# the server builds /api/ingest's request enum from the first, and the client's model
# dropdown reads the second. If they drift, the client asks for a model the route
# rejects with a 400.
GROQ_FREE_MODEL=""
NEXT_PUBLIC_GROQ_FREE_MODEL=""
# PRO plans only. gpt-4o -> OpenAI, claude-3-5-sonnet-20240620 -> Anthropic.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Stripe (Phase 3 - subscriptions) ---
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=""
# The recurring Price id for the $10/mo Pro plan (price_...), from Products.
STRIPE_PRICE_ID=""
# Signing secret for the checkout webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=""
# Optional: only needed if you use @stripe/stripe-js on the client. The hosted
# Checkout redirect flow used here does not require it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Razorpay (India / INR - the primary gateway for the INR price) ---
# Every one of these is read by the code and NONE of them were documented here,
# which is a silent-failure setup: deploy from this file and Indian payments fail
# with no obvious cause. Dashboard > Settings > API Keys.
#
# NOTE THE BILLING SHAPE. Unlike Stripe above, this path is a ONE-TIME payment,
# not a recurring subscription (see src/app/api/razorpay/verify/route.ts). Pro is
# granted for a fixed 30 or 365 days and then expires via `currentPeriodEnd` -
# nothing auto-renews, so a monthly buyer lapses unless they pay again.
RAZORPAY_KEY_ID=""
# The same key id, exposed to the browser so Checkout can open. Must match
# RAZORPAY_KEY_ID exactly - the server signs against the secret for this pair.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Server-side secret. Used twice: to create orders, and to verify the client
# callback as HMAC(order_id|payment_id, KEY_SECRET).
RAZORPAY_KEY_SECRET=""
# A DIFFERENT secret from KEY_SECRET: set when you create the webhook endpoint in
# Dashboard > Settings > Webhooks, and used to verify the raw body of webhook
# deliveries. Mixing the two up makes every webhook fail signature validation.
RAZORPAY_WEBHOOK_SECRET=""

# --- Resend (transactional email) ---
# Used by /api/cron/renewal-reminder to warn a Pro subscriber before their plan
# lapses. Unset is a SUPPORTED state: lib/email.ts degrades to a no-op and the cron
# reports `skipped` rather than failing, so local dev and the Capacitor build need
# neither of these.
RESEND_API_KEY=""
# Must be on a domain verified in the Resend dashboard - Resend rejects anything else,
# so there is deliberately no default here to fall back to.
RESEND_FROM_EMAIL="FlowRecall <hello@yourdomain.com>"

# --- Cron (Vercel) ---
# Vercel signs each cron invocation with `Authorization: Bearer <CRON_SECRET>`.
# Routes under /api/cron fail CLOSED when this is unset - every request is
# rejected rather than left public.
CRON_SECRET=""

# --- Capacitor Android build only (BUILD_TARGET=capacitor, see next.config.ts) ---
# Absolute origin of the LIVE deployment (Vercel) this exported shell calls for
# everything server-side - auth, AI grading/ingest, DB reads, payments. Unset
# for the normal web build/deploy, where API calls stay same-origin.
NEXT_PUBLIC_API_URL=""

# --- Cron auth (src/app/api/cron/keep-alive, scheduled via vercel.json) ---
# Generate with: openssl rand -hex 32
# Set this in Vercel's Project Settings > Environment Variables too - Vercel
# signs every cron invocation with this exact value as a Bearer token, which
# is what stops the route from being a public, unauthenticated DB-ping endpoint.
CRON_SECRET=""
