<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- allowBackup is a DECISION, not the default it happens to match. Android
         auto-backup is currently the only thing that rescues a student's
         on-device library when they change phones - the IndexedDB deck store,
         reviews and reading positions live in the app's own data directory and
         nothing else carries them across a device swap unless they signed in
         first. So it stays on, and the transfer is declared on the Play Data
         Safety form. The real fix is the Restore Credentials API, which Play
         requires by April 2027 anyway; this is the stopgap that costs nothing.

         enableOnBackInvokedCallback: predictive back is the platform default for
         apps targeting SDK 35+, and this app targets 36. Declaring it makes the
         app's participation explicit instead of version-dependent, and it is what
         lets the gesture draw its animation rather than snapping. The handler
         itself is src/components/BackButtonBridge.tsx - without a registered
         listener, back closes the app from wherever the student happens to be. -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Portrait-locked, and resizing declined, for the closed test. Every
             layout in this app was designed and measured at 360dp portrait; with
             no orientation declared, Play offers it in landscape, split-screen and
             freeform, none of which has ever been rendered once. This narrows that
             untested surface rather than closing it: Android 16 IGNORES
             resizeableActivity="false" on large screens for apps targeting SDK 36,
             so a tablet can still resize the app. Tablets are their own piece of
             work, done deliberately, not discovered from a tester's screenshot. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google OAuth runs in the system browser (Custom Tabs), not the
                 app's own WebView - Google blocks/discourages its consent
                 screen in embedded WebViews, and this keeps the session cookie
                 bridging described in src/app/api/auth/mobile-exchange/route.ts
                 working. After sign-in, /api/mobile-callback 302s the system
                 browser here; Android hands the intent back to this activity
                 (singleTask above) instead of opening a browser tab.

                 autoVerify="true" makes this a verified Android App Link, not
                 a bare custom scheme - Android checks
                 https://www.flowrecall.app/.well-known/assetlinks.json
                 (public/.well-known/assetlinks.json in this repo) proves this
                 exact app owns that domain before ever routing the link here,
                 so (unlike the flowrecall:// scheme below) no other app can
                 register the same host and receive it via a disambiguation
                 chooser. See src/lib/mobileAuth.ts for the full flow. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.flowrecall.app" android:pathPrefix="/auth-callback" />
            </intent-filter>

            <!-- Legacy fallback ONLY, for the rare case App Link verification
                 above hasn't taken effect yet (e.g. moments after a fresh
                 install) - src/app/auth-callback/page.tsx forwards here if the
                 https link above ever lands in a real browser instead of
                 being intercepted by the OS. Never the primary redirect
                 target - see src/lib/mobileAuth.ts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flowrecall" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Android 11+ (API 30, targetSdk here is 36) hides all other apps from
         PackageManager.queryIntentActivities() unless the caller declares
         what it's looking for - without this, @capacitor/browser's
         Browser.open() (used by the Google sign-in flow - see
         src/app/login/page.tsx and src/app/account/page.tsx) can't find
         Chrome/any browser to hand the URL to and throws
         "Unable to display URL". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- POST_NOTIFICATIONS, VIBRATE, WAKE_LOCK and RECEIVE_BOOT_COMPLETED are merged
         in by @capacitor/local-notifications and are all wanted: the nightly study
         reminder needs the first, and the last is what survives a reboot.

         SCHEDULE_EXACT_ALARM is removed on purpose. It is a Play policy-restricted
         permission that expects a core feature genuinely requiring exact timing (an
         alarm clock, a calendar alert), and a nightly nudge is not that - a few
         minutes of drift is invisible. Requesting it anyway invites a review question
         we would have no good answer to.

         Safe to remove, and checked on the device rather than assumed: the plugin
         marks every notification isExactNotification=true by default, so the thing
         that actually decides is the second half of its own guard -
         `isExactNotification && canScheduleExactAlarms(alarmManager)`. On API 31+
         without this permission that call returns false and LocalNotificationManager
         falls back to setAndAllowWhileIdle, which still wakes the device from doze.
         No SecurityException, a few minutes of drift, and nothing to explain to a
         Play reviewer. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
</manifest>
